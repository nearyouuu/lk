FROM python:3.12-slim-bookworm

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        patchelf \
        ccache \
    && rm -rf /var/lib/apt/lists/*

# Keep Python dependencies in a layer that is invalidated only when req.txt
# changes. The old COPY-before-install layout reinstalled everything after
# every application source edit.
COPY req.txt /src/req.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip \
    && python -m pip install -r /src/req.txt \
    && python -m pip install nuitka ordered-set zstandard

COPY . .

ENV SKIP_BUILD_DEP_INSTALL=1 \
    CCACHE_DIR=/root/.cache/ccache \
    NUITKA_CACHE_DIR=/root/.cache/Nuitka

# Persist compiler and Nuitka caches across application source changes.
RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/root/.cache/Nuitka \
    chmod +x /src/scripts/build_ubuntu_nuitka.sh \
    && /src/scripts/build_ubuntu_nuitka.sh \
    && mkdir -p /out \
    && cp -R /src/dist/ubuntu-release/. /out/
